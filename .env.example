APP_PORT=8000

DB_HOST=db
# Port di sisi HOST untuk membuka database dari GUI client (DBeaver, Workbench).
# Aplikasi TIDAK memakainya - app terhubung ke container `db` lewat network
# internal Docker di port 3306. Sengaja bukan 3306 supaya `docker compose up`
# tidak gagal di mesin yang sudah menjalankan MySQL/MariaDB lokal.
DB_PORT=3307
DB_DATABASE=iom_db
DB_USERNAME=iom_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
