/vendor/
.env
.env.local

/database/*.sqlite

# PRD-01: gambar produk diunggah ke public/ (bukan storage/ di luar docroot)
# supaya bisa diakses langsung via URL tanpa Controller streaming khusus -
# public/ memang satu-satunya docroot yang dilayani `php -S -t public`
# (lihat Dockerfile), jadi ini pilihan paling sederhana untuk aset gambar
# katalog yang memang tidak sensitif/tidak perlu access-control tambahan.
/public/uploads/products/*
!/public/uploads/products/.gitkeep

.phpunit.cache/
.phpunit.result.cache
/docs/quality/static-analysis/*.cache
/coverage/

*.log
.DS_Store
Thumbs.db

# Disposable static preview copies (visual QA only, not part of the app)
/public/_preview-*.php

# SonarQube: token dikirim lewat environment variable, tidak pernah di-commit
.scannerwork/

# Artefak render sementara untuk QA deck presentasi
/docs/presentation/slide-*.jpg
/docs/presentation/*.pdf
